# Copy this per environment — `.env.dev`, `.env.test-prod` — and pass it with
# `--env-file` to both docker compose and `uv run`. Only values that differ
# between environments belong in those copies; anything identical stays a
# config.py default.

# ── Environment identity (docker compose only, not read by config.py) ─────────
# Names the compose project, so the container, network and named volume are
# namespaced and two environments never share a database.
CBAC_ENV=dev

# Host port the container's 5432 is published on. Unique per environment.
PG_PORT=5432

POSTGRES_USER=cbac_user
POSTGRES_PASSWORD=cbac_pass
POSTGRES_DB=cbac

# Host directory the data lives in, bind-mounted in place of a Docker named
# volume. Must exist and be writable by the container's postgres user (uid 999).
# Comment it out to use the named volume `cbac-$CBAC_ENV_pgdata` instead.
PG_DATA_PATH=/root/agentdna-v2/dev/pgdump/cbac_service

# Host port OpenFGA's HTTP API is published on (loopback only). Unique per
# environment.
OPENFGA_HTTP_PORT=8080

# ── Database ──────────────────────────────────────────────────────────────────
# Async Postgres connection string (asyncpg driver). Must agree with the
# POSTGRES_* and PG_PORT values above.
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://your_user@localhost:5432/cbac

# ── Provenance Layer ──────────────────────────────────────────────────────────
# API key for the agent-dna Provenance Layer (Rubix chain connector).
AGENTDNA_API_KEY=
# The chain connector to fetch policy from. Only set this to point at a
# different one (staging, self-hosted).
PROVENANCE_URL=https://chain-connector-2.rubix.net
#https://chain-connector-2-dev.rubix.net

# ── Service binding & logging ─────────────────────────────────────────────────
CBAC_SERVICE_HOST=127.0.0.1
CBAC_SERVICE_PORT=8767
CBAC_SERVICE_LOG_LEVEL=INFO

# ── v2 gate: OpenFGA ──────────────────────────────────────────────────────────
# Must agree with OPENFGA_HTTP_PORT above.
OPENFGA_API_URL=http://localhost:8080
# One store per environment.
OPENFGA_STORE_NAME=cbac-dev
# OpenFGA's pre-shared key. Read by docker compose (OPENFGA_AUTHN_PRESHARED_KEYS)
# and by the service; compose refuses to start OpenFGA without it.
OPENFGA_API_TOKEN=
# Seconds an intent's grants stay live after its first call.
INTENT_TTL_SECONDS=3600

# ── v2 gate: parsers ──────────────────────────────────────────────────────────
# "<backend>:<model>", backend "ollama", "anthropic" or "nvidia", e.g.
# anthropic:claude-opus-5-5 for the policy parser.
POLICY_PARSER_MODEL=ollama:qwen3:14b
QUERY_PARSER_MODEL=ollama:qwen3:14b
# The query parser's own deadline (seconds) and output cap (tokens). A guarded
# tool call waits on it, and its answer is a short list of grants.
QUERY_PARSER_TIMEOUT_SECONDS=15
QUERY_PARSER_MAX_TOKENS=1024
# Seconds a failed query parse is remembered. Calls with that intent id deny
# (4004) at once in that window instead of parsing again.
QUERY_PARSER_RETRY_SECONDS=30
OLLAMA_URL=http://localhost:11434
# Only for an anthropic: model. Empty lets the SDK find credentials itself.
ANTHROPIC_API_KEY=
# Only for an nvidia: model, e.g.
# nvidia:nvidia/nemotron-3-nano-omni-30b-a3b-reasoning.
NVIDIA_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=

# ── v2 gate: policy endpoints ─────────────────────────────────────────────────
# Shared secret for /cbac/v2/policies*, sent as X-CBAC-Key. Unset = those
# endpoints refuse every request.
CBAC_POLICY_KEY=

# ── Search & indexing ─────────────────────────────────────────────────────────
# pgvector index type: "hnsw" (low-latency) or "ivfflat" (large scale).
VECTOR_INDEX_TYPE=hnsw

# Enable hybrid search (BM25 + vector fusion). Set to "false" to use vector-only.
HYBRID_SEARCH_ENABLED=false

# Reciprocal Rank Fusion constant (higher = less aggressive re-ranking).
RRF_K=60
