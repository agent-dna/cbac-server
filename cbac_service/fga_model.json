      "name": "non_expired_grant",
      "expression": "current_time < grant_time + grant_duration",
      "parameters": {
        "current_time": {"type_name": "TYPE_NAME_TIMESTAMP"},
        "grant_time": {"type_name": "TYPE_NAME_TIMESTAMP"},
