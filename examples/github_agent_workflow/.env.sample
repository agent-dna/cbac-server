# ── CBAC decision service ─────────────────────────────────────────────────────
# Where the guard sends its authorization calls.
CBAC_URL=http://127.0.0.1:8767
# Whose policy is checked. With the service started via service.py, this must
# match a policies/<name>.md file. Against a chain-backed service, use the
# actor id.
# The gateway pins this rather than trusting the caller's header — see
# "Trust boundary" in README.md.
CBAC_AGENT_ID=github-worker
# Seconds. A cold service loads three transformer models on the first request.
CBAC_TIMEOUT=600

# ── LLM ───────────────────────────────────────────────────────────────────────
# Must support tool calling. Options: openai | gemini | ollama
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=
# Optional — set for an OpenAI-compatible proxy. Must include the /v1 root.
OPENAI_BASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal Access Token: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# ── MCP server (started by `python agent.py serve`) ───────────────────────────
# CBAC-unaware, stands in for a third-party server. The agent never connects
# here directly — only the gateway does.
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765

# ── CBAC gateway (started by `python gateway.py`) ─────────────────────────────
# The enforcement point. The agent's MCP client points here.
CBAC_GATEWAY_HOST=127.0.0.1
CBAC_GATEWAY_PORT=8766
# Fail-closed: deny any tools/call arriving without the X-CBAC-* context
# headers. Setting this false degrades to a policy-only check (no drift check).
CBAC_REQUIRE_CONTEXT=true
# Optional — the upstream the gateway proxies to. Defaults to MCP_SERVER_*.
# MCP_UPSTREAM_URL=http://127.0.0.1:8765/mcp/
# The second upstream: a real third-party MCP server, public and unauthenticated.
# Nobody in this repo owns it, and the same policy decides its calls. The gateway
# exposes its tools as deepwiki_<tool>.
MCP_THIRDPARTY_URL=https://mcp.deepwiki.com/mcp

